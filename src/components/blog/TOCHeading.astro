---
import type { TocItem } from '@/utils'

interface Props {
	heading: TocItem
}

const {
	heading: { depth, slug, subheadings, text }
} = Astro.props
---

<li class={`${depth > 2 ? 'ms-3' : ''}`}>
	<a
		aria-label={`Scroll to section: ${text}`}
		class={`block line-clamp-2 py-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground ${depth > 2 ? 'pl-2' : ''}`}
		href={`#${slug}`}
	>
		{text}
	</a>
	{
		!!subheadings.length && (
			<ul class='flex flex-col'>
				{subheadings.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ul>
		)
	}
</li>
