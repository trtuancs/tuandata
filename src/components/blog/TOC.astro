---
import type { MarkdownHeading } from 'astro'
import { generateToc } from '@/utils'

import TOCHeading from './TOCHeading.astro'

interface Props {
	headings: MarkdownHeading[]
}

const { headings } = Astro.props

const toc = generateToc(headings)
---

<aside class='sticky top-20 order-2 -me-28 hidden basis-60 lg:flex lg:flex-col'>
	<div class='flex flex-col gap-y-2 pb-4'>
		<h2 class='font-posttitle text-sm uppercase tracking-wide'>Mục lục</h2>
		<hr class='border-border' />
	</div>
	<nav id='toc-nav'>
		<ul class='flex flex-col gap-y-1 text-base'>
			{toc.map((heading) => <TOCHeading heading={heading} />)}
		</ul>
	</nav>
</aside>

<script>
	function initTOC() {
		const tocLinks = document.querySelectorAll('#toc-nav a')
		if (!tocLinks.length) return

		// Get all headings with IDs
		const headings = Array.from(document.querySelectorAll('article [id]')).filter(
			(el) => el.tagName.match(/^H[2-4]$/)
		) as HTMLElement[]

		if (!headings.length) return

		let activeLink: HTMLAnchorElement | null = null

		const setActiveLink = (link: HTMLAnchorElement) => {
			// Remove active class from all links
			tocLinks.forEach((l) => {
				l.classList.remove('active-toc-link')
			})
			// Add active class to current link
			link.classList.add('active-toc-link')
			activeLink = link
		}

		const updateActiveLink = () => {
			const scrollY = window.scrollY

			// Find the current heading in view
			let currentHeading: HTMLElement | null = null

			for (let i = headings.length - 1; i >= 0; i--) {
				const heading = headings[i]
				const rect = heading.getBoundingClientRect()
				const absoluteTop = rect.top + scrollY

				if (scrollY >= absoluteTop - 100) {
					currentHeading = heading
					break
				}
			}

			// If we found a heading, highlight its TOC link
			if (currentHeading) {
				const id = currentHeading.getAttribute('id')
				const tocLink = document.querySelector(`#toc-nav a[href="#${id}"]`) as HTMLAnchorElement
				if (tocLink && tocLink !== activeLink) {
					setActiveLink(tocLink)
				}
			} else if (tocLinks[0]) {
				// Default to first link if at top of page
				setActiveLink(tocLinks[0] as HTMLAnchorElement)
			}
		}

		// Update on scroll
		window.addEventListener('scroll', updateActiveLink, { passive: true })

		// Set initial active link
		updateActiveLink()
	}

	// Initialize on page load
	initTOC()

	// Re-initialize after page transitions
	document.addEventListener('astro:page-load', initTOC)
</script>

<style>
	#toc-nav a {
		transition: all 0.2s ease;
		font-weight: 400;
	}

	#toc-nav a.active-toc-link {
		color: hsl(var(--primary)) !important;
		font-weight: 700 !important;
	}
</style>
