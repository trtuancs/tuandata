---
import type { MarkdownHeading } from 'astro'
import { generateToc } from '@/utils'

import TOCHeading from './TOCHeading.astro'

interface Props {
	headings: MarkdownHeading[]
}

const { headings } = Astro.props

const toc = generateToc(headings)
---

<aside class='sticky top-20 order-2 -me-28 hidden basis-60 lg:flex lg:flex-col'>
	<div class='flex flex-col gap-y-2 pb-4'>
		<h2 class='font-posttitle text-sm uppercase tracking-wide'>Mục lục</h2>
		<hr class='border-border' />
	</div>
	<nav id='toc-nav'>
		<ul class='flex flex-col gap-y-1 text-base'>
			{toc.map((heading) => <TOCHeading heading={heading} />)}
		</ul>
	</nav>
</aside>

<script>
	function initTOC() {
		const tocNav = document.getElementById('toc-nav')
		if (!tocNav) return

		const tocLinks = Array.from(tocNav.querySelectorAll('a')) as HTMLAnchorElement[]
		if (!tocLinks.length) return

		// Get all headings that have corresponding TOC links
		const headingIds = tocLinks.map(link => {
			const href = link.getAttribute('href')
			return href ? href.substring(1) : null // Remove the '#'
		}).filter(Boolean) as string[]

		const headings = headingIds.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[]

		if (!headings.length) {
			console.warn('No headings found for TOC')
			return
		}

		let activeLink: HTMLAnchorElement | null = null
		let ticking = false

		const setActiveLink = (link: HTMLAnchorElement) => {
			if (activeLink === link) return

			// Remove active styling from all links
			tocLinks.forEach((l) => {
				l.classList.remove('active-toc-link')
				l.style.color = ''
				l.style.fontWeight = ''
			})
			// Add active styling to current link
			link.classList.add('active-toc-link')
			link.style.color = 'hsl(var(--primary))'
			link.style.fontWeight = '700'
			activeLink = link
		}

		const updateActiveLink = () => {
			const scrollY = window.scrollY + 150 // Add offset for better UX

			// Find the current heading in view
			let currentHeading: HTMLElement | null = null

			for (let i = headings.length - 1; i >= 0; i--) {
				const heading = headings[i]
				const top = heading.offsetTop

				if (scrollY >= top) {
					currentHeading = heading
					break
				}
			}

			// If we found a heading, highlight its TOC link
			if (currentHeading) {
				const id = currentHeading.getAttribute('id')
				const tocLink = tocLinks.find(link => link.getAttribute('href') === `#${id}`)
				if (tocLink) {
					setActiveLink(tocLink)
				}
			} else if (tocLinks[0]) {
				// Default to first link if at top of page
				setActiveLink(tocLinks[0])
			}

			ticking = false
		}

		// Debounced scroll handler
		const onScroll = () => {
			if (!ticking) {
				window.requestAnimationFrame(updateActiveLink)
				ticking = true
			}
		}

		// Update on scroll
		window.addEventListener('scroll', onScroll, { passive: true })

		// Set initial active link after a short delay to ensure DOM is ready
		setTimeout(updateActiveLink, 100)
	}

	// Initialize on page load
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initTOC)
	} else {
		initTOC()
	}

	// Re-initialize after page transitions
	document.addEventListener('astro:page-load', initTOC)
</script>

<style>
	#toc-nav a {
		transition: all 0.2s ease;
	}
</style>
