---
import PageLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import { Image } from 'astro:assets'
import avt from '../assets/tuandata-avt.png'
import Label from '../components/Label.astro'
import Card from '../components/Card.astro'
import SkillLayout from '../components/SkillLayout.astro'

const apis = ['flask']
const operating_system = ['CentOS Linux', 'Ubuntu Linnux']
const cloud = ['GCP', 'AWS']
const monitor = ['Grafana - Prometheus']
const bi = ['Tableau', 'Superset', 'Redash']
const language = ['Python', 'SQL', 'Bash Script', 'Java']
const database = ['PostgreSQL and Extensions', 'Clickhouse', 'Redis', 'MySQL', 'MongoDB']
const data_warehouse = ['BigQuery', 'Snowflake']
const etl = ['Airflow', 'Flink', 'Spark', 'Kafka', 'RabbitMQ', 'DBT', 'Debezium', 'StreamSets']
const soft = ['Teamwork', 'Adaptability', 'Creativity', 'Problem-solving', 'Time management']
const tools = ['Jira', 'Pycharm', 'Jupyter Notebook']
const devops = ['Git', 'Jenkins', 'Docker', 'Kubernetes', 'Terraform']

const meta = {
	description: 'Xem CV & hồ sơ chuyên môn của Tuân Data – Senior Data Engineer với kinh nghiệm thực tế về Data Engineering, SQL, Python, Big Data & Cloud Computing.',
	title: 'CV Tuân Data – Senior Data Engineer | SQL, Python, Big Data'
}
---
<PageLayout meta={meta}>
    <div class='flex w-full flex-col gap-y-10'>
		<section class='flex flex-col items-center gap-y-7'>
			<Image
				src={avt}
				alt='profile photo'
				width="150" height="150"
				class="w-32 h-32 border-2 border-input rounded-full"	
				loading='eager'
			/>

			<div class='flex flex-col items-center gap-y-4'>
				<h1 class='text-3xl font-posttitle'>Trong Tuan Le</h1>
				<a
					class='flex flex-row items-center gap-x-3 rounded-3xl border border-input px-4 py-2 text-md'
				>
					<span class='relative flex items-center justify-center'>
						<span
							class='absolute inline-flex h-2 w-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'
						></span>
						<span class='relative inline-flex h-2 w-2 rounded-full bg-green-400'></span>
					</span>

					<p class='text-lg'>Senior Data Engineer</p>
				</a>
				<div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
					<Label title='Ho Chi Minh City, Viet Nam' class="text-lg">
						<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' class='h-5 w-5' slot='icon'
							><path
								fill='currentColor'
								d='M12.003 11.73q.668 0 1.14-.475q.472-.475.472-1.143t-.475-1.14q-.476-.472-1.143-.472t-1.14.476q-.472.475-.472 1.143t.475 1.14q.476.472 1.143.472M12 19.677q2.82-2.454 4.458-4.991q1.638-2.538 1.638-4.39q0-2.744-1.737-4.53T12 3.981q-2.621 0-4.359 1.785t-1.737 4.53q0 1.852 1.638 4.39q1.639 2.537 4.458 4.99m0 1.343q-3.525-3.117-5.31-5.814q-1.786-2.697-1.786-4.909q0-3.173 2.066-5.234Q9.037 3 12 3t5.03 2.062q2.066 2.061 2.066 5.234q0 2.212-1.785 4.909q-1.786 2.697-5.311 5.814m0-10.904'
							></path></svg
						>
					</Label>
					<Label title='contact.tuandata@gmail.com' class="text-lg">
						<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 256 256' class='h-5 w-5' slot='icon'
							><path
								fill='currentColor'
								d='M224 48H32a8 8 0 0 0-8 8V192a16 16 0 0 0 16 16H216a16 16 0 0 0 16-16V56A8 8 0 0 0 224 48ZM203.43 64 128 133.15 52.57 64ZM216 192H40V74.19l82.59 75.71a8 8 0 0 0 10.82 0L216 74.19V192Z'
							></path></svg
						>
					</Label>
					<Label
						title='Linkedin'
						class="text-lg"
						as='a'
						href='https://www.linkedin.com/in/trtuancs/'
						target='_blank'
					>
						<svg
							xmlns='http://www.w3.org/2000/svg'
							viewBox='0 0 16 16'
							slot='icon'
							class='h-5 w-5 text-foreground/75'
							><path
								fill='currentColor'
								d='M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248c-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586c.173-.431.568-.878 1.232-.878c.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252c-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z'
							></path></svg
						>
					</Label>
				</div>
			</div>
		</section>

		<Section title='About'>
			<p class='text-lg text-muted-foreground'>
				I’m a Senior Data Engineer with 5+ years of experience (since 2019). </br>
				I build and maintain enterprise data platforms and big-data analytics systems 
				on on-premises infrastructure using open-source technologies.
			</p>
		</Section>

		<Section title='Skills'>
			<SkillLayout title='API' skills={apis} />
			
			<SkillLayout title='Cloud service' skills={cloud} />
			<SkillLayout title='Monitoring' skills={monitor} />
			<SkillLayout title='Data warehouse' skills={data_warehouse} />
			<SkillLayout title='Operating system' skills={operating_system} />
			<SkillLayout title='BI tool' skills={bi} />
			<SkillLayout title='Tool' skills={tools} />
			<SkillLayout title='Programing language' skills={language} />
			<SkillLayout title='DevOps' skills={devops} />
			
			<SkillLayout title='Database' skills={database} />
			<SkillLayout title='ETL pipeline' skills={etl} />
			<SkillLayout title='Soft skill' skills={soft} />
			
		</Section>

		<!-- {
			allPostsByDate.length > 0 && (
				<Section title='Posts'>
					<ul class='flex flex-col gap-y-2'>
						{allPostsByDate.map((p) => (
							<li class='flex flex-col gap-x-2 sm:flex-row'>
								<PostPreview post={p} />
							</li>
						))}
					</ul>
				</Section>
			)
		} -->

		<Section title='Experience'>
			<Card
				heading='Senior Data Engineer'
				subheading='Galaxy Play'
				date='Feb 2023 - Present'
				imagePath='/src/assets/about-astro.png'
				altText=''
				imageClass='h-12 w-auto md:-left-16'
			>
				<ul class='ml-4 list-disc text-muted-foreground'>
					<li>
						Building, optimizing, and maintaining a Data Platform for processing 20 million events 
						and data from multiple data sources every day.
						<li>
							Collaborate with stakeholders across various departments and use BI tools to analyze data, gain insights, and help them make decisions.
						</li>
					</li>
				</ul>
			</Card>
			<Card
				heading='Data Engineer'
				subheading='Galaxy Play'
				date='Jan 2021 - Feb 2023'
				imagePath='/src/assets/about-astro.png'
				altText=''
				imageClass='h-12 w-auto md:-left-16'
			>
				<ul class='ml-4 list-disc text-muted-foreground'>
					<li>Create and maintain data documentation.
						<li>Implement the system pipelines (Data Warehouse, Data Mart).
							<li>Design pipelines and architectures for data processing.
								<li>Engineer data platforms to automate/facilitate data related processes.
									<li>Recommend and implement ways to improve data reliability, efficiency and quality.
										<li>Obtain and integrate data and information from various sources into Data Warehouse.
											<li>Collaborate with relevant teams on opportunities to manage data and provide solutions for complex data.
												<li>Write scripts and ingest raw data to build and maintain optimized data pipelines and ETL solutions as business support tools in
													providing analysis.
													<li>Maintain data integration processes into the data platform by building data pipelines and align with business representatives
														and business information needs.
														<li>Deliver functionality/data required for business and data analysts, data scientists and other business roles to advance the overall
															analytic performance and strategy of company.
															<li>Collaborate with Data Scientists to understand data requirements and create re-usable data assets to enable data scientists to
																build and deploy machine learning models faster.
																<li>Coordinate with partners to exchange or enrich data in alignment with business goals.
																	<li>Optimize data pipeline and system performance.
																	</li>
																</li>
															</li>
														</li>
													</li>
												</li>
											</li>
										</li>
									</li>
								</li>
							</li>
						</li>
					</li>
				</ul>
			</Card>
			<Card
				heading='Data Engineer'
				subheading='WeVenture'
				date='Aug 2019 - Apr 2020'
				imagePath='/src/assets/about-astro.png'
				altText=''
				imageClass='h-12 w-auto md:-left-16'
			>
				<ul class='ml-4 list-disc text-muted-foreground'>
					<li>Create and maintain the system pipeline and data documentation.
						<li>Integrate massive datasets from multiple data sources for data modelling.
							<li>Design, build-up, implement, optimize the data/ETL pipeline with the rest of the Data Engineer team.
							</li>
						</li>
					</li>
				</ul>
			</Card>
			<Card
				heading='Research Engineer Intern'
				subheading='WeVenture'
				date='May 2019 - Aug 2019'
				imagePath='/src/assets/about-astro.png'
				altText=''
				imageClass='h-12 w-auto md:-left-16'
			>
				<ul class='ml-4 list-disc text-muted-foreground'>
					<li>Research time series forecasting models: LSTM, RNN, ARIMA.
						<li>Research customer segmentation models: RFM, K-mean, DBSCAN, Dicision tree.
						</li>
					</li>
				</ul>
			</Card>
		</Section>

		<Section title='Education'>
			<Card
				heading='Computer Science'
				subheading='Ho Chi Minh University of Technology (Bach Khoa HCM)'
				date='2016'
				imagePath='/src/assets/about-astro.png'
				altText=''
				imageClass='h-12 w-auto md:-left-16'
			/>
		</Section>

		<Section title='Certifications'>
			<Card
				as='a'
				heading='Data Engineering, Big Data, and Machine Learning on GCP'
				subheading='Coursera'
				date='Issued: Aug 2023'
				imagePath='/src/assets/about-astro.png'
				altText='Credential ID: C628NSJSCVAR'
				imageClass='h-11 w-auto md:-left-16'
				href='https://www.coursera.org/account/accomplishments/specialization/certificate/C628NSJSCVAR'
			/>
		</Section>
	</div>
</PageLayout>

