---
import PageLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import Label from '../components/Label.astro'
import { Image } from 'astro:assets'
import avt from '../assets/tuandata-avt.png'
import { getAllPosts, sortMDByDate } from '../utils'

const meta = {
	description: 'Tuân Data là trang web chia sẻ kiến thức Data Engineering, SQL, Python & Big Data.',
	title: 'Tuân Data | Chia Sẻ Kiến Thức Data Engineering & Lập Trình'
}

const allPosts = await getAllPosts()
const sortedPosts = sortMDByDate(allPosts)
const latestPosts = sortedPosts.slice(0, 4)
---

<PageLayout meta={meta}>
	<div class='flex w-full flex-col gap-y-10'>
		<section class='flex flex-col items-center gap-y-7'>
			<Image
				src={avt}
				alt='tuandata-photo'
				width="150" height="150"
				class="w-32 h-32 border-2 border-input rounded-full"	
				loading='eager'
				quality={100}
			/>

			<div class='flex flex-col items-center gap-y-4'>
				<h1 class='text-3xl font-posttitle'>Lê Trọng Tuân</h1>
				<a
					class='flex flex-row items-center gap-x-3 rounded-3xl border border-input px-4 py-2 text-md'
				>
					<span class='relative flex items-center justify-center'>
						<span
							class='absolute inline-flex h-2 w-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'
						></span>
						<span class='relative inline-flex h-2 w-2 rounded-full bg-green-400'></span>
					</span>

					<p class='text-lg'>Senior Data Engineer</p>
				</a>
				<div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
					<Label title='Tp. Hồ Chí Minh, Việt Nam' class="text-lg">
						<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' class='h-5 w-5' slot='icon'
							><path
								fill='currentColor'
								d='M12.003 11.73q.668 0 1.14-.475q.472-.475.472-1.143t-.475-1.14q-.476-.472-1.143-.472t-1.14.476q-.472.475-.472 1.143t.475 1.14q.476.472 1.143.472M12 19.677q2.82-2.454 4.458-4.991q1.638-2.538 1.638-4.39q0-2.744-1.737-4.53T12 3.981q-2.621 0-4.359 1.785t-1.737 4.53q0 1.852 1.638 4.39q1.639 2.537 4.458 4.99m0 1.343q-3.525-3.117-5.31-5.814q-1.786-2.697-1.786-4.909q0-3.173 2.066-5.234Q9.037 3 12 3t5.03 2.062q2.066 2.061 2.066 5.234q0 2.212-1.785 4.909q-1.786 2.697-5.311 5.814m0-10.904'
							></path></svg
						>
					</Label>
					<Label title='contact.tuandata@gmail.com' class="text-lg">
						<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 256 256' class='h-5 w-5' slot='icon'
							><path
								fill='currentColor'
								d='M224 48H32a8 8 0 0 0-8 8V192a16 16 0 0 0 16 16H216a16 16 0 0 0 16-16V56A8 8 0 0 0 224 48ZM203.43 64 128 133.15 52.57 64ZM216 192H40V74.19l82.59 75.71a8 8 0 0 0 10.82 0L216 74.19V192Z'
							></path></svg
						>
					</Label>
					<Label
						title='Facebook'
						class="text-lg"
						as='a'
						href='https://www.facebook.com/trtuan.data'
						target='_blank'
					>
						<svg
							xmlns='http://www.w3.org/2000/svg'
							viewBox='0 0 16 16'
							slot='icon'
							class='h-5 w-5 text-foreground/75'
							><path
							fill="currentColor"
							d="M16 8.049c0-4.446-3.582-8.05-8-8.05S0 3.603 0 8.049c0 3.993 2.925 7.31 6.75 7.951v-5.625H4.72V8.049h2.03V6.275c0-2.007 1.194-3.118 3.022-3.118.875 0 1.791.157 1.791.157v1.98h-1.01c-.993 0-1.303.621-1.303 1.258v1.497h2.218l-.354 2.326H9.25V16c3.825-.64 6.75-3.958 6.75-7.951z"
							/>
						</svg
						>
					</Label>
				</div>
			</div>
		</section>

		<Section title='Giới thiệu'>
			<p class='text-lg text-muted-foreground'>
				Chào mọi người, mình là Tuân - Senior Data Engineer với hơn 5 năm kinh nghiệm trong lĩnh vực Data (từ năm 2019).
			</p>
			<p>
				Thông qua các kênh social <strong>Tuân Data</strong>, Tuân muốn chia sẻ kiến thức <strong>Data Engineering & Lập trình</strong> theo cách dễ hiểu,
				thực tế nhất, giúp bạn bắt đầu hành trình làm việc với dữ liệu một cách tự tin.
			</p>
		</Section>

		<section class='flex flex-col gap-y-6'>
			<div class='flex flex-col gap-y-3'>
				<h2 class='text-2xl font-posttitle'>Bài viết mới nhất</h2>
				<hr class='border-border' />
			</div>

			{latestPosts.length > 0 ? (
				<div class='grid gap-6 md:grid-cols-2 lg:grid-cols-4'>
					{latestPosts.map((post) => (
						<a
							href={`/blog/${post.slug}/`}
							class='flex flex-col overflow-hidden rounded-2xl border border-border bg-card transition-all hover:border-foreground/25 hover:shadow-lg'
							data-astro-prefetch
						>
							{post.data.coverImage ? (
								<div class='aspect-video w-full overflow-hidden bg-muted'>
									<Image
										src={post.data.coverImage.src}
										alt={post.data.coverImage.alt}
										class='h-full w-full object-cover'
										loading='lazy'
									/>
								</div>
							) : (
								<div class='aspect-video w-full bg-gradient-to-br from-primary/10 to-secondary/10'></div>
							)}
							<div class='flex flex-col gap-3 p-5'>
								{post.data.tags.length > 0 && (
									<span class='inline-block w-fit rounded-md bg-primary/10 px-3 py-1 text-xs font-medium text-primary'>
										{post.data.tags[0]}
									</span>
								)}
								<h3 class='text-xl font-posttitle line-clamp-2'>
									{post.data.title}
								</h3>
								<p class='text-base text-muted-foreground line-clamp-3'>
									{post.data.description}
								</p>
							</div>
						</a>
					))}
				</div>
			) : (
				<p class='text-muted-foreground'>Chưa có bài viết nào.</p>
			)}

			<!-- <div class='text-center sm:text-end'>
				<Button title='Xem tất cả bài viết' href='/blog/' style='button'>
					<svg
						xmlns='http://www.w3.org/2000/svg'
						width='14'
						height='14'
						viewBox='0 0 24 24'
						slot='icon-after'
					>
						<path
							fill='currentColor'
							d='m17.079 11.5l-5.792-5.792L12 5l7 7l-7 7l-.713-.708L17.079 12.5H5v-1z'
						>
						</path>
					</svg>
				</Button>
			</div> -->
		</section>

	</div>
</PageLayout>
